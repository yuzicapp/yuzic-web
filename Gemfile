source "https://rubygems.org"
gem 'github-pages'
# Removed from Ruby's default gems but still required by Jekyll 3.9 — the
# versions here are for local builds only, since GitHub Pages builds with its
# own bundle. `webrick` went in Ruby 3.0 and is what `jekyll serve` runs on,
# so without it the serve command in the README could not start at all; the
# rest went in 3.4.
gem "webrick"
gem "csv"
gem "base64"
gem "logger"
gem "bigdecimal"
